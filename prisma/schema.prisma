// prisma/schema.prisma
//
// V2.0 数据层：把「长期记忆」从 data/memory.json 搬进 SQLite。
//
// 几条刻意的取舍（改之前先读，别按直觉"优化"）：
//   1. layer / status / polarity 用 String 不用 enum —— SQLite 不支持 Prisma enum。
//      类型安全由 lib/memory/store.ts 里的 TS 联合类型守住，库里只是文本。
//   2. 不加 @@unique([userId, layer, keyword, status]) —— 现有语义允许同一个 keyword
//      同时存在 active / deleted / superseded 多行（软删除要留痕）。加唯一键会在
//      状态流转时直接冲突。去重仍由事务内的 findFirst 完成。
//   3. category / polarity / source / createdAt 是用户清单里没写、但现有代码在用的字段，
//      不落库就是静默丢数据。
//   4. User.id 沿用现有的 u_xxx / guest_xxx：游客升级成正式用户时**不换 id**，
//      记忆天然继承，不需要搬数据。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // file:../data/cuixiang.db —— 相对 schema 所在目录，最终落在项目根的 data/ 下。
  // data/ 已被 .gitignore 排除，库文件和归档备份都在一起。
  url      = env("DATABASE_URL")
}

/// 用户：游客与注册用户同一张表，靠 isGuest 区分
model User {
  id        String   @id // u_xxx / guest_xxx，升级时不换
  email     String?  @unique // 游客为 null
  password  String? // bcrypt hash，游客为 null
  isGuest   Boolean  @default(true)
  /// "USER" | "ADMIN"（SQLite 无 enum，类型安全由 lib/auth 的 TS 联合类型守）
  /// 签发 JWT 时作为快照写进 payload；缺省 USER，旧 token 自动降级
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memories Memory[]
  messages Message[]
}

/// 长期记忆：替代 data/memory.json 里的 MemoryRecord[]
model Memory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// core_profile | summary_memory | fragment_memory
  layer   String
  keyword String
  content String
  /// active | pending | resolved | superseded | deleted
  status  String  @default("active")
  /// 适用场景，没有则 null
  context String?

  /// 「过敏忌口」等分类，factsFromMessage / decideMemoryAction 用
  category String?
  /// 喜欢 | 不喜欢 | 拒绝 | 接受 | 中立 | 不确定
  polarity String?
  /// 「对话提取」「冲突确认」
  source   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 召回按 (userId, layer, status) 过滤，写盘上限按 (userId, updatedAt) 排序
  @@index([userId, layer, status])
  @@index([userId, updatedAt])
}

/// 聊天日志（V3.0 Admin「对话审查」数据源）。
/// 写入原则：日志写挂不阻断对话（logMessage 失败只打点）；
/// 只存用户看得到的内容（用户原话 / 模型最终回复），trace 原始 JSON 不落这里。
model Message {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "user" | "assistant"（SQLite 无 enum）
  role    String
  /// 用户原话 / 模型 final 定稿文本（流式不存中间 delta）
  content String
  /// 结构化结果数组的 JSON 文本（SQLite 无 Json scalar，读取方 JSON.parse）；
  /// 零食业务时代的推荐卡字段，换血后对话不再产卡，新数据恒为 null。user 轮为 null
  cards   String?
  /// 关联本轮 TraceID，Admin 审查时一键回溯
  traceId String?

  createdAt DateTime @default(now())

  // 对话审查按用户翻页；看板按时间聚合
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// 知识库条目（HR FAQ）：
/// 新员工入职问答的知识源。检索链路（lib/llm/local-workflow.ts）只读
/// status='active'、未软删除、scope 匹配、allowedRoles 包含当前用户角色的条目。
/// SQLite 无 scalar list：tags / allowedRoles 存 JSON 字符串，业务层 parse。
/// 业务删除一律软删除（isDeleted + deletedAt 留痕）。
model KnowledgeItem {
  id           String    @id
  question     String
  answer       String
  /// JSON string: ["入职材料"]
  tags         String    @default("[]")
  /// 当前只有 new_hire_public
  scope        String    @default("new_hire_public")
  /// JSON string: ["new_hire"]；预留 employee
  allowedRoles String    @default("[\"new_hire\"]") @map("allowed_roles")
  status       String    @default("active")
  source       String
  version      Int       @default(1)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, isDeleted])
  @@index([scope])
  @@map("knowledge_items")
}
