// prisma/schema.prisma
//
// HR 助理数据层（2026-11-08 瘦身）：User / Message（对话审查） / KnowledgeItem（HR FAQ）。
// 旧业务的 Memory（长期记忆）model 已随记忆功能下线整体删除（批次：基建净化），
// 记忆相关代码（lib/memory/store.ts 及配套脚本）一并移除。
//
// 取舍备忘（改之前先读，别按直觉"优化"）：
//   1. role / status 等语义字段用 String 不用 enum —— SQLite 不支持 Prisma enum，
//      类型安全由 lib/ 下对应的 TS 联合类型守住，库里只是文本。
//   2. User.id 沿用 u_xxx / guest_xxx：游客升级成正式用户时**不换 id**，
//      历史 Message 日志天然继承，不需要搬数据。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // file:../data/hr-assistant.db —— 相对 schema 所在目录，最终落在项目根的 data/ 下。
  // data/ 已被 .gitignore 排除，库文件和归档备份都在一起。
  url      = env("DATABASE_URL")
}

/// 用户：游客与注册用户同一张表，靠 isGuest 区分
model User {
  id             String   @id // u_xxx / guest_xxx，升级时不换
  email          String?  @unique // 游客为 null
  password       String? // bcrypt hash，游客为 null
  isGuest        Boolean  @default(true)
  /// 工作台展示用的姓名/部门（可空：老账号与游客没有这两项，界面显示「未设置」）。
  /// 与 auth 角色正交，不参与鉴权判断。
  name           String?
  department     String?
  /// 员工编号：登录页「员工编号 / 员工账号」的第二种标识（可空唯一，老账号没有）。
  /// 由管理员分配，编号的生成与批量维护属于后续步骤。
  employeeNo     String?  @unique
  /// 是否启用：停用账号禁止登录，带旧票据直闯工作台也会被服务端拒绝。
  /// 默认 true，老账号与游客不受影响；停用由管理员在后续员工管理步骤维护。
  isActive       Boolean  @default(true)
  /// "USER" | "ADMIN"（SQLite 无 enum，类型安全由 lib/auth 的 TS 联合类型守）
  /// 签发 JWT 时作为快照写进 payload；缺省 USER，旧 token 自动降级
  role           String   @default("USER")
  /// 知识库可见性维度的员工类型："new_hire" | "employee"（与 auth 角色正交，批次10 新增）
  /// 不入 JWT：转正/调整要立即生效，不走 token 快照，每次请求读库
  ///（mapKnowledgeRole，lib/auth/knowledge-role.ts）
  employeeType   String   @default("new_hire") @map("employee_type")
  /// 入职日期，默认建行时间。90 天窗口内的 new_hire 由 mapKnowledgeRole 自动"转正"；
  /// Admin 可改此字段把人留在/送入新员工期
  onboardingDate DateTime @default(now()) @map("onboarding_date")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages Message[]
}

/// 工作台部门目录（文档第 4/6 步）：员工管理与组织架构共用这一份，
/// 不靠 User.department 去重去猜有哪些部门。预置 5 个示例部门由 lib/workspace/departments.ts 幂等写入。
model Department {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("departments")
}

/// 制度知识库（文档第 8/9 步）：原始文件保存在 data/policies/（已被 .gitignore 排除），
/// 解析出的正文入库供详情预览与后续问答引用。
/// status: queued 排队中 → parsing 解析中 → pending 待发布 / failed 失败
///         → published 已发布 / archived 已下架
model PolicyDocument {
  id             String    @id
  name           String
  category       String
  /// 'all' 全员，或某个部门名
  scope          String    @default("all")
  version        String
  /// YYYY-MM-DD；只有生效日期不晚于今天且已发布的制度才对员工可见
  effectiveDate  String    @map("effective_date")
  status         String    @default("queued")
  failureReason  String?   @map("failure_reason")
  content        String    @default("")
  fileName       String    @map("file_name")
  filePath       String    @map("file_path")
  mimeType       String    @map("mime_type")
  uploadedById   String    @map("uploaded_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  publishedAt    DateTime? @map("published_at")
  archivedAt     DateTime? @map("archived_at")

  @@index([status])
  @@map("policy_documents")
}

/// 聊天日志（V3.0 Admin「对话审查」数据源）。
/// 写入原则：日志写挂不阻断对话（logMessage 失败只打点）；
/// 只存用户看得到的内容（用户原话 / 模型最终回复），trace 原始 JSON 不落这里。
model Message {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "user" | "assistant"（SQLite 无 enum）
  role    String
  /// 用户原话 / 模型 final 定稿文本（流式不存中间 delta）
  content String
  /// 关联本轮 TraceID，Admin 审查时一键回溯
  traceId String?

  createdAt DateTime @default(now())

  // 对话审查按用户翻页；看板按时间聚合
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// 知识库条目（HR FAQ）：
/// 新员工入职问答的知识源。检索链路（lib/llm/local-workflow.ts）只读
/// status='active'、未软删除、scope 匹配、allowedRoles 包含当前用户角色的条目。
/// SQLite 无 scalar list：tags / allowedRoles 存 JSON 字符串，业务层 parse。
/// 业务删除一律软删除（isDeleted + deletedAt 留痕）。
model KnowledgeItem {
  id           String    @id
  question     String
  answer       String
  /// JSON string: ["入职材料"]
  tags         String    @default("[]")
  /// 当前只有 new_hire_public
  scope        String    @default("new_hire_public")
  /// JSON string: ["new_hire"]；预留 employee
  allowedRoles String    @default("[\"new_hire\"]") @map("allowed_roles")
  status       String    @default("active")
  source       String
  version      Int       @default(1)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, isDeleted])
  @@index([scope])
  @@map("knowledge_items")
}

/// 年假台账（文档第 11~13 步）：余额不落字段，恒等于该员工该年度所有流水的合计。
/// 历史流水只追加、永不删除；调整、导入对账、示例数据都各写一行留痕。
/// delta 允许 0.5 天粒度，可正可负；kind 区分来源，便于解释余额怎么来的。
model LeaveLedger {
  id         String   @id
  userId     String   @map("user_id")
  year       Int
  delta      Float
  reason     String
  /// "adjust" 手动调整 / "reconcile" 导入对账 / "grant" 发放 / "taken" 已休 / "demo" 示例数据
  kind       String
  operatorId String?  @map("operator_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, year, createdAt])
  @@map("leave_ledger")
}

/// 对话模型连接配置（文档第 14 步）：单行记录，密钥以 AES-256-GCM 密文存放。
/// 明文密钥只在服务端内存里短暂存在，任何接口都不回传浏览器；留空表示沿用已有凭据。
model ModelConfig {
  id           String   @id @default("default")
  endpoint     String
  modelName    String   @map("model_name")
  encryptedKey String   @default("") @map("encrypted_key")
  hasKey       Boolean  @default(false) @map("has_key")
  temperature  Float    @default(0.3)
  maxTokens    Int      @default(2048) @map("max_tokens")
  version      Int      @default(0)
  updatedById  String?  @map("updated_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("model_configs")
}

/// 操作审计（文档第 14 步先落记录，页面在第 38 步做）。
/// 红线：detail 里绝不写密钥、密码或凭据原文。
model AuditLog {
  id        String   @id
  action    String
  actorId   String   @map("actor_id")
  actorName String   @map("actor_name")
  target    String
  detail    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}
